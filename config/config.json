{
    "configuration":
    {
        "debug": false,
        "apiBaseUrl": "api/",
        "defaultApiHeaders": 
        {
            "Accept": "application/json"
        },
        "themes":
        [
            "light",
            "dark"
        ],
        "languages":
        [
            {
                "lang": "en",
                "name": "English"
            },
            {
                "lang": "sk",
                "name": "Slovenčina"
            }
        ],
        "keycloak":
        {
            "oauthServerUrl": "https://keycloak/",
            "keycloakRealm": "realm",
            "keycloakClient": "client",
            "redirectUri": "http://localhost:8888/"
        }
    },
    "general":
    {
        "theme": "light",
        "language": "en"
    },
    "debug":
    {
        "consoleEnabled": false,
        "debugData": false
    },
    "logging":
    {
        "consoleLogLevel": "verbose"
    }
}